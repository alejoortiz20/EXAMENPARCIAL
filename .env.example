# Copiar a .env y completar con los valores reales.
#   copy .env.example .env     (Windows CMD)
#   cp .env.example .env       (Git Bash / Linux / macOS)
#
# NOTA: los valores reales NO viven en este archivo. Viven en tu .env local,
# que esta excluido por .gitignore. Este repo es publico.

# --- Redis Cloud ---
REDIS_URL=
REDIS_HOST=
REDIS_PORT=16639
REDIS_USER=default
REDIS_PASSWORD=

# --- CloudAMQP ---
AMQP_URL=
AMQP_HOST=
AMQP_USER=
AMQP_PASSWORD=
AMQP_VHOST=
AMQP_PORT=5671
AMQP_PORT_TLS=5671
AMQP_PORT_PLAIN=5672

# --- PieSocket ---
PIESOCKET_CLUSTER_ID=
PIESOCKET_API_KEY=
PIESOCKET_API_SECRET=
PIESOCKET_API_ID=

# --- Algolia ---
# OJO: el host lleva el sufijo -dsn. Sin el, no resuelve por DNS.
ALGOLIA_APP_ID=
ALGOLIA_HOST=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_WRITE_API_KEY=

# --- Render ---
RENDER_API_KEY=

# --- GitHub ---
# El token ya vive como variable de entorno del usuario de Windows
# (GITHUB_PERSONAL_ACCESS_TOKEN). No hace falta duplicarlo aqui.
GITHUB_OWNER=
GITHUB_TOKEN=

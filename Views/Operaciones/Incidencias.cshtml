@model List<EXAMENPARCIAL.Models.Incidencia>
@{
    ViewData["Title"] = "Buscar incidencias";
    var criticas = Model.Count(i => i.Prioridad == 3);
    var altas = Model.Count(i => i.Prioridad == 2);
    var termino = ViewData["Busqueda"] as string ?? string.Empty;
    var buscando = termino.Length > 0;
}

<h1>Incidencias abiertas encontradas</h1>

<p class="lede">
    Averias reportadas en estaciones de bicicletas compartidas. Cerrar una incidencia
    la retira del listado activo.
</p>

<form class="buscador" method="get" action="/Operaciones/Incidencias" role="search">
    <label class="buscador__label" for="q">Buscar incidencia</label>
    <div class="buscador__caja">
        <span class="buscador__icono" aria-hidden="true"></span>
        <input id="q" name="q" type="search" value="@termino"
               placeholder="Nombre de estacion o descripcion de la averia"
               autocomplete="off" />
        <button type="submit" class="btn btn--primary">Buscar</button>
        @if (buscando)
        {
            <a class="btn btn--ghost" href="/Operaciones/Incidencias">Limpiar</a>
        }
    </div>
    @if (buscando)
    {
        <p class="buscador__nota" role="status">
            <strong>@Model.Count</strong>
            @(Model.Count == 1 ? "resultado" : "resultados") para &laquo;@termino&raquo;
        </p>
    }
</form>

<section class="stats" aria-label="Resumen del estado">
    <div class="stat">
        <span class="stat__label">Abiertas</span>
        <span class="stat__value">@Model.Count</span>
    </div>
    <div class="stat stat--critica">
        <span class="stat__label">Criticas</span>
        <span class="stat__value">@criticas</span>
    </div>
    <div class="stat stat--alta">
        <span class="stat__label">Prioridad alta</span>
        <span class="stat__value">@altas</span>
    </div>
</section>

@if (buscando && Model.Count == 0)
{
    <div class="empty">
        <p class="empty__title">Sin coincidencias</p>
        <p class="empty__body">
            Ninguna incidencia abierta coincide con &laquo;@termino&raquo;.
            Prueba con el nombre de la estacion o parte de la descripcion.
        </p>
    </div>
}
else if (Model.Count == 0)
{
    <div class="empty">
        <p class="empty__title">Sin incidencias abiertas</p>
        <p class="empty__body">Todas las averias reportadas fueron cerradas. No hay nada pendiente de atencion.</p>
    </div>
}
else
{
    <ul class="incidencias" role="list">
        @foreach (var i in Model)
        {
            <li class="incidencia incidencia--p@(i.Prioridad)">
                <div class="incidencia__id" aria-hidden="true">#@i.Id.ToString("D3")</div>
                <div class="incidencia__body">
                    <h2 class="incidencia__estacion">@i.Estacion</h2>
                    <p class="incidencia__descripcion">@i.Descripcion</p>
                </div>
                <div class="incidencia__meta">
                    <span class="pill pill--p@(i.Prioridad)">
                        @(i.Prioridad switch { 3 => "Critica", 2 => "Alta", _ => "Baja" })
                    </span>
                    <span class="estado">@i.Estado</span>
                </div>
                <form asp-controller="Operaciones" asp-action="Cerrar" method="post" class="incidencia__accion">
                    <input type="hidden" name="id" value="@i.Id" />
                    <button type="submit" class="btn btn--primary">Cerrar</button>
                </form>
            </li>
        }
    </ul>
}

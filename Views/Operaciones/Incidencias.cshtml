@model List<EXAMENPARCIAL.Models.Incidencia>
@{
    ViewData["Title"] = "Incidencias";

    var criticas = Model.Count(i => i.Prioridad == 3);
    var altas = Model.Count(i => i.Prioridad == 2);
    var termino = ViewData["Busqueda"] as string ?? string.Empty;
    var buscando = termino.Length > 0;

    var origen = (string?)ViewData["OrigenListado"] ?? "Base de datos";
    var origenClase = origen == "Redis" ? "origen--redis" : "origen--base";

    var cluster = Environment.GetEnvironmentVariable("PIESOCKET_CLUSTER_ID");
    var canal = Environment.GetEnvironmentVariable("PIESOCKET_CHANNEL");
    var clave = Environment.GetEnvironmentVariable("PIESOCKET_API_KEY");
    var sesion = Guid.NewGuid().ToString("N");

    cluster = string.IsNullOrWhiteSpace(cluster) ? "free.blr2" : cluster;
    canal = string.IsNullOrWhiteSpace(canal) ? "incidencias-operaciones" : canal;
    clave = clave ?? string.Empty;

    var ws = string.Format(
        "wss://{0}.piesocket.com/v4/{1}?api_key={2}&notify_self=1&source=jssdk&v=4.2.3&presence=1&uuid={3}",
        cluster,
        Uri.EscapeDataString(canal),
        Uri.EscapeDataString(clave),
        sesion);
}

<h1>Incidencias abiertas encontradas con consulta rápida en tiempo real</h1>

<p class="lede">
    Averias reportadas en estaciones de bicicletas compartidas. Cerrar una incidencia
    la retira del listado activo y se propaga al instante al resto de las sesiones.
</p>

<form class="buscador" method="get" action="/Operaciones/Incidencias" role="search">
    <label class="buscador__label" for="q">Buscar incidencia</label>
    <div class="buscador__caja">
        <span class="buscador__icono" aria-hidden="true"></span>
        <input id="q" name="q" type="search" value="@termino"
               placeholder="Nombre de estacion o descripcion de la averia"
               autocomplete="off" />
        <button type="submit" class="btn btn--primary">Buscar</button>
        @if (buscando)
        {
            <a class="btn btn--ghost" href="/Operaciones/Incidencias">Limpiar</a>
        }
    </div>
    @if (buscando)
    {
        <p class="buscador__nota" role="status">
            <strong>@Model.Count</strong>
            @(Model.Count == 1 ? "resultado" : "resultados") para &laquo;@termino&raquo;
        </p>
    }
</form>

<p class="origen @origenClase" role="status">
    Listado servido desde <strong>@origen</strong>
</p>

<p class="tr-estado" id="tr-estado" data-estado="conectando" role="status">
    <span class="tr-estado__punto" aria-hidden="true"></span>
    <span id="tr-texto">Conectando con PieHost&hellip;</span>
</p>

<div id="panel">
    @await Html.PartialAsync("_Panel", Model)
</div>

<div class="toast" id="tr-toast" role="status" aria-live="polite" hidden></div>

<div id="tr-config" data-ws="@ws" data-panel="@Url.Action("Panel", "Operaciones")" hidden></div>

@section Scripts {
    <script src="~/js/tiemporeal.js" asp-append-version="true"></script>
}
